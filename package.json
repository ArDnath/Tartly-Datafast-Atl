{
  "name": "revenuelens",
  "version": "1.0.0",
  "description": "Revenue-first analytics and attribution for indie SaaS.",
  "author": "Tartly",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": "^10.10.0 <11"
  },
  "scripts": {
    "predev": "npm-run-all check-env update-db build-db",
    "dev": "dotenv -- next dev --turbo",
    "dev:local": "bash scripts/local-dev.sh",
    "db:local": "bash scripts/local-db.sh",
    "smoke:local": "node scripts/local-smoke.mjs",
    "build": "npm-run-all check-env build-db check-db build-tracker build-recorder build-app",
    "start": "next start",
    "build-docker": "npm-run-all build-db build-tracker build-recorder build-app-docker",
    "start-docker": "node scripts/start-docker.mjs",
    "start-env": "node scripts/start-env.js",
    "start-server": "node scripts/start-server.mjs",
    "build-app": "next build --webpack",
    "build-app-docker": "next build --webpack",
    "build-components": "node scripts/bump-components.js && tsup",
    "build-tracker": "rollup -c rollup.tracker.config.js",
    "build-recorder": "rollup -c rollup.recorder.config.js",
    "build-prisma-client": "node scripts/build-prisma-client.js",
    "build-db": "npm-run-all build-db-client build-prisma-client",
    "build-db-schema": "prisma db pull",
    "build-db-client": "prisma generate",
    "update-db": "npm-run-all update-db-prisma update-db-clickhouse",
    "update-db-prisma": "prisma migrate deploy",
    "update-db-clickhouse": "tsx scripts/migrate-clickhouse.ts",
    "check-db": "node scripts/check-db.js",
    "check-env": "node scripts/check-env.js",
    "copy-db-files": "node scripts/copy-db-files.js",
    "postbuild": "node scripts/postbuild.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:deploy": "node --test scripts/deploy-smoke.test.mjs",
    "typecheck": "tsc --noEmit",
    "gate": "npm-run-all gate:format gate:lint gate:typecheck gate:test gate:deploy gate:build",
    "gate:format": "biome format .",
    "gate:lint": "biome lint .",
    "gate:typecheck": "tsc --noEmit",
    "gate:test": "vitest run --coverage",
    "gate:deploy": "npm-run-all gate:deploy-scripts gate:deploy-smoke",
    "gate:deploy-scripts": "bash -n deploy/production/deploy.sh && bash -n scripts/apply-branch-protection.sh && node --check scripts/deploy-smoke.mjs",
    "gate:deploy-smoke": "node --test scripts/deploy-smoke.test.mjs",
    "audit:prod": "pnpm audit --prod --audit-level critical",
    "gate:build": "SKIP_DB_CHECK=1 pnpm build",
    "tartly": "node scripts/tartly-cli.mjs",
    "mcp": "node scripts/tartly-mcp.mjs",
    "load:ingest": "node scripts/load-ingest.mjs",
    "worker:attribution": "tsx scripts/talivia-attribution-worker.ts",
    "rotate:provider-secrets": "tsx scripts/rotate-provider-secrets.ts",
    "legacy:precheck": "tsx scripts/legacy-table-drop.ts",
    "proxy:lemonsqueezy-webhook": "tsx scripts/local-lemonsqueezy-webhook-proxy.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write"
  },
  "cacheDirectories": [
    ".next/cache"
  ],
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
