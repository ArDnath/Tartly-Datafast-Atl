# Tartly production environment. Copy to .env next to this file, fill in,
# chmod 600, never commit. Every value here is a secret except the last group.

# --- Required ---
# Runtime connection. On Neon this is the POOLED host (contains -pooler).
DATABASE_URL=
# Direct host (no -pooler) for prisma migrate only. Never used at runtime.
DATABASE_URL_UNPOOLED=
# 32+ random bytes: openssl rand -hex 32. Signs auth tokens and encrypts
# provider credentials. Rotating invalidates sessions and stored credentials.
APP_SECRET=
# Public origin used in verification/reset/invitation links.
APP_URL=https://tartly.in

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Tartly <no-reply@tartly.in>

# --- Platform billing (Dodo). Leave empty until Step 4 is run. ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=live
DODO_STARTER_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
DODO_STARTER_ANNUAL_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=

# --- Operator ---
# Comma-separated allowlist that grants the platform-admin console
# (/app/settings/admin, audit, activation, suspension).
PLATFORM_ADMIN_EMAILS=

# --- Fixed production behaviour ---
COOKIE_SECURE=true
# Error tracking (optional): POST unhandled errors as JSON to this endpoint.
# ERROR_TRACKING_WEBHOOK=

# --- Edge config read by docker compose (not passed to the app) ---
TARTLY_DOMAIN=tartly.in
ACME_EMAIL=support@tartly.in
# Absolute path to the repository clone on the VPS.
TARTLY_APP_DIR=/opt/tartly/app
# Set to the release commit SHA at build time.
BUILD_VERSION=local
