# Tartly production runtime environment.
#
# Install as /opt/tartly/runtime/.env, owned by the deploy user with mode 600.
# Never commit this file. The deploy script never prints its values.
#
# Generate secrets with: openssl rand -hex 32
# The database/cache URLs MUST use the same passwords as the *_PASSWORD keys
# below; Compose reads the password keys and the app reads the URLs.

# ---------------------------------------------------------------------------
# Origin and edge
# ---------------------------------------------------------------------------
APP_URL=https://tartly.in
TARTLY_DOMAIN=tartly.in
ACME_EMAIL=support@tartly.in
# Absolute path to the git clone used as the Docker build context.
TARTLY_APP_DIR=/opt/tartly/app
# Set by deploy.sh to the commit SHA. Do not set a stale value here.
BUILD_VERSION=local
NODE_OPTIONS=--dns-result-order=ipv4first --no-network-family-autoselection

# ---------------------------------------------------------------------------
# PostgreSQL (container: postgres)
# ---------------------------------------------------------------------------
POSTGRES_DB=tartly
POSTGRES_USER=tartly
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
DATABASE_URL=postgresql://tartly:replace-with-the-same-password@postgres:5432/tartly
DATABASE_URL_UNPOOLED=postgresql://tartly:replace-with-the-same-password@postgres:5432/tartly

# Signs auth tokens and encrypts provider credentials at rest. At least 32
# bytes. Never rotate without the re-encryption procedure in
# docs/SECRETS_ROTATION.md.
APP_SECRET=replace-with-openssl-rand-hex-32
APP_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Redis (container: redis)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_URL=redis://:replace-with-the-same-password@redis:6379/0

# ---------------------------------------------------------------------------
# ClickHouse + Kafka (containers: clickhouse, kafka)
# ---------------------------------------------------------------------------
# Leave CLICKHOUSE_URL empty to keep analytics queries in PostgreSQL. When it
# is set, run the clickhouse-migrate service first:
#   docker compose --env-file .env --profile tools run --rm clickhouse-migrate
CLICKHOUSE_USER=talivia
CLICKHOUSE_DB=talivia
CLICKHOUSE_PASSWORD=replace-with-openssl-rand-hex-32
CLICKHOUSE_URL=http://talivia:replace-with-the-same-password@clickhouse:8123/talivia

# KAFKA_URL is only used for its optional credentials; the broker list is
# KAFKA_BROKER. The worker consumes the four analytics topics.
KAFKA_URL=kafka://kafka:9092
KAFKA_BROKER=kafka:9092
KAFKA_SASL_MECHANISM=plain

# ---------------------------------------------------------------------------
# Interactive authentication (Google OAuth)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in the Google Cloud console.
GOOGLE_REDIRECT_URI=https://tartly.in/api/auth/google/callback

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Tartly <no-reply@tartly.in>
COOKIE_SECURE=true
# Optional error-tracking endpoint; receives a JSON POST for server errors.
ERROR_TRACKING_WEBHOOK=

# ---------------------------------------------------------------------------
# Platform billing (Dodo Payments) — context A, charges our customers.
# Separate from the per-website analytics Dodo connections.
# ---------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_STARTER_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
DODO_STARTER_ANNUAL_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=
DODO_PRODUCT_IDS_JSON=

# Comma-separated platform operator emails. An empty list disables the legacy
# platform-admin console in production.
PLATFORM_ADMIN_EMAILS=
