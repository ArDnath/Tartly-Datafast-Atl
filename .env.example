# RevenueLens environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# Generate APP_SECRET with: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Runtime database connection (Neon pooled host, or local PostgreSQL).
DATABASE_URL=postgresql://user:password@localhost:5432/revenuelens

# Direct/unpooled database connection used by `prisma migrate` and the Prisma
# CLI. On Neon copy the "direct" connection string. Leave blank locally to
# fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Signs auth tokens and encrypts provider credentials at rest. At least 32
# bytes. Changing this invalidates sessions and breaks stored provider secrets.
APP_SECRET=replace-with-a-long-random-value
# Only during a planned key rotation: the previous APP_SECRET, used to read
# existing provider credentials. Remove after `pnpm rotate:provider-secrets`.
APP_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Database options
# ---------------------------------------------------------------------------

# Optional read replica for analytics queries.
DATABASE_REPLICA_URL=

# Optional PostgreSQL schema (default: public).
# Set via the `?schema=` query parameter on DATABASE_URL, not here.

# ---------------------------------------------------------------------------
# Cache / queue (optional; omit for single-instance local development)
# ---------------------------------------------------------------------------

# Optional. Redis is used for website/session caching and collector helpers.
# Authentication sessions and login rate limits use PostgreSQL instead, so a
# missing Redis instance never disables brute-force protection.
REDIS_URL=

# ClickHouse is optional. If set, analytics queries use ClickHouse and events
# are mirrored to PostgreSQL for attribution. This fork does not provision
# ClickHouse by default.
CLICKHOUSE_URL=

# Kafka is optional and only used with ClickHouse.
KAFKA_URL=
KAFKA_BROKER=
KAFKA_SASL_MECHANISM=plain

# ---------------------------------------------------------------------------
# Analytics integrations (customers connect these; not platform billing)
# ---------------------------------------------------------------------------

# Optional fallback webhook secrets. Normal connections store secrets per
# website (encrypted) and do not need these.
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=

# Optional crypto FX conversion for revenue reporting.
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Platform billing (Dodo Payments) — Phase 5
# ---------------------------------------------------------------------------

# Separate from the per-website analytics Dodo connections above. These
# credentials charge workspace owners for RevenueLens (context A).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Monthly products are required for checkout. Annual products are optional
# until the two-months-free annual prices exist in the Dodo dashboard.
DODO_STARTER_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
DODO_STARTER_ANNUAL_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=

# ---------------------------------------------------------------------------
# Transactional email (invitations, verification, password reset, usage)
# ---------------------------------------------------------------------------

# Public origin used to build invitation, verification, and reset links.
APP_URL=http://localhost:3000
# Reject events whose payload hostname/Origin does not match the website's
# configured domain. Off by default so onboarding cannot silently stop
# collection; turn on after the first verified event.
ENFORCE_TRACKER_ORIGIN=
# Reject signups from built-in disposable-inbox providers. Set true only for a
# private/test deployment where the list gets in the way.
ALLOW_DISPOSABLE_EMAILS=
# Extra comma-separated disposable domains to block.
DISPOSABLE_EMAIL_DOMAINS=
# Force the Secure cookie flag outside production (e.g. HTTPS preview), or
# set false to test a production build over local HTTP.
COOKIE_SECURE=
# Write development email bodies to .dev-emails/outbox.log even when running a
# production build locally. Never enable in production.
EMAIL_OUTBOX=
EMAIL_FROM="RevenueLens <hello@example.com>"
RESEND_API_KEY=

# Optional error-tracking endpoint. Receives a JSON POST for server errors.
# Leave empty to keep structured logs local (the default).
ERROR_TRACKING_WEBHOOK=

# ---------------------------------------------------------------------------
# Internal platform administration. Comma-separated emails or user IDs.
# These users may access the legacy /api/users console. In production an empty
# list disables platform administration entirely.
PLATFORM_ADMIN_EMAILS=

# Optional release-check endpoint for self-hosted installs. Leave empty on the
# hosted product; no installation telemetry is sent.
OSS_UPDATE_URL=

# Runtime tuning / local development
# ---------------------------------------------------------------------------

# Skip the DB version check during build in constrained CI.
SKIP_DB_CHECK=
# Skip applying migrations automatically in production.
SKIP_DB_MIGRATION=
# Disable bot filtering (never in production).
DISABLE_BOT_CHECK=
# Trust a specific proxy header for the client IP.
CLIENT_IP_HEADER=
# Comma-separated IPs/CIDRs to ignore for analytics.
IGNORE_IP=
# Skip edge/CDN country headers and use local MaxMind (requires geo data).
SKIP_LOCATION_HEADERS=
# Do not strip trailing slashes from tracked URLs.
REMOVE_TRAILING_SLASH=
# Log every SQL query (very noisy; local only).
LOG_QUERY=
# Use UUIDv7 for new ids.
USE_UUIDV7=
# Salt rotation window for server-side visitor ids: month | week | day.
SALT_ROTATION=month
# Default report currency.
DEFAULT_CURRENCY=USD

# Analytics retention job. Set true to count expired event/replay/session rows
# without deleting them. Dry-run is off by default; the daily cron job runs at
# 03:30 UTC in production.
ANALYTICS_RETENTION_DRY_RUN=

# Attribution worker tuning
TALIVIA_WORKER_BATCH_SIZE=
TALIVIA_WORKER_MAX_ATTEMPTS=
TALIVIA_WORKER_BACKOFF_SECONDS=
TALIVIA_WORKER_STALE_MINUTES=
TALIVIA_WORKER_PAYMENT_LIMIT=

# Build/version label surfaced by the health endpoint.
BUILD_VERSION=local
